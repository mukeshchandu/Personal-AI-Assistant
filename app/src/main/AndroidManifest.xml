<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Naomi's ears + cloud brain -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Set timers / alarms without the user tapping through the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- "Call <name>" / messaging: look up contacts, place calls, send texts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Calendar: read today's events. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- "Hey Naomi" always-listening wake word (Vosk, offline). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the wake service alive when the phone is locked/idle. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Light up the screen when woken while it's off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Re-arm the wake listener automatically after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ensure location is on for accurate ride pickup / food delivery (one-tap system dialog). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Turn on Bluetooth via the one-tap system consent dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pop the UI to the front from the background / lock screen when woken. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps" — lets the wake service launch the UI from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+: needed to find / launch other apps, the dialer, messaging, music. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.spotify.music" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.ubercab" />
        <package android:name="com.olacabs.customer" />
        <package android:name="com.rapido.passenger" />
        <package android:name="in.swiggy.android" />
        <package android:name="com.swiggy.android" />
        <package android:name="com.application.zomato" />
        <package android:name="com.application.zomato.district" />
        <package android:name="com.google.android.keep" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Naomi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Naomi"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auto-taps WhatsApp's Send button. User enables it in Settings → Accessibility. -->
        <service
            android:name=".WhatsAppSender"
            android:exported="false"
            android:label="Naomi WhatsApp auto-send"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Always-listening "Hey Naomi" wake word (Vosk, offline). -->
        <!-- stopWithTask=false keeps it running when the app is swiped from recents. -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!-- Re-arm "Hey Naomi" automatically after the phone reboots. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>